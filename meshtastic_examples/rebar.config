%% Needs OTP 27+ (the built-in json module).
%%
%% Erlang (src/*.erl) and LFE (src/*.lfe) in one app: the rebar3_lfe
%% plugin adds an LFE compiler to `rebar3 compile'.
%%
%% emqtt, gun and cowlib exactly as in ../lora_mesh/rebar.config (and
%% rebar.config.script turns QUIC off the same way).

{erl_opts, [debug_info]}.

{deps, [{emqtt,
         {git, "https://github.com/emqx/emqtt.git", {tag, "1.16.1"}}},
        {gun, "2.1.0"},
        {cowlib, "2.13.0"},
        {lfe,
         {git, "https://github.com/lfe/lfe.git", {tag, "v2.2.2"}}}]}.

{plugins, [{rebar3_gpb_plugin, "3.0.1"},
           {rebar3_lfe,
            {git, "https://github.com/lfe-rebar3/rebar3_lfe.git", {tag, "0.5.8"}}}]}.

%% --- protobuf: generate src/mt_pb.erl in MAPS mode ---
%% The same Meshtastic definitions as ../lora_mesh/proto (GPL-3.0, see
%% proto/LICENSE.meshtastic-protobufs); proto/mt.proto imports them all.
%% Used by the decode and protos examples. Unlike lora_mesh (records),
%% messages here are maps, like the dicts
%% of the Python examples, with oneofs flat:
%%   #{to => 1, decoded => #{portnum => 'TEXT_MESSAGE_APP', payload => <<"hi">>}}
{gpb_opts, [{i, "proto"},
            {f, ["mt.proto"]},
            {module_name_suffix, "_pb"},
            maps,
            {maps_oneof, flat},
            use_packages,
            {rename, {msg_name, snake_case}},
            {rename, {msg_name, dots_to_underscores}},
            {rename, {msg_fqname, base_name}},
            {strings_as_binaries, true},
            {o_erl, "src"},
            {o_hrl, "include"}]}.

{provider_hooks, [{pre, [{compile, {protobuf, compile}},
                         {clean, {protobuf, clean}}]}]}.

%% `rebar3 escriptize' -> _build/default/bin/mte, one file to copy around.
%% +Bd: Ctrl-C ends the program (no BREAK menu).
{escript_name, mte}.
{escript_main_app, meshtastic_examples}.
{escript_incl_apps, [lfe, emqtt, gun, cowlib, getopt]}.
{escript_emu_args, "%%! +Bd -escript main mte\n"}.

{shell, [{apps, [meshtastic_examples]}]}.
