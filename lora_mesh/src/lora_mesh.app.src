{application, lora_mesh,
 [{description, "Meshtastic and MeshCore bridges, router and registry, record style"},
  {vsn, "0.3.0"},
  {registered, [lora_mesh_sup,
                lora_mesh_registry,
                lora_mesh_router,
                lora_mesh_connector_mqtt]},
  {mod, {lora_mesh_app, []}},
  {applications, [kernel,
                  stdlib,
                  emqtt]},
  {env, [{role, full},
         {bridges, [#{id => home,
                      host => "192.168.1.50",
                      port => 4403}]},
         {dedup_ms, 200},
         {mqtt, #{host => "localhost",
                  port => 1883,
                  prefix => <<"mesh">>}}]},
  {licenses, ["GPL-3.0-only"]}
 ]}.
