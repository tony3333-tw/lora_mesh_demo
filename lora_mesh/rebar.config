%% Needs OTP 27+ (uses the built-in json module).

{erl_opts, [debug_info,
            {i, "include"}]}.

%% emqtt comes from git, not Hex: for a Hex package rebar3 takes the
%% dependency list stored on Hex (which includes quicer) and never runs
%% emqtt's rebar.config.script, so BUILD_WITHOUT_QUIC would be ignored.
%%
%% gun and cowlib are pinned: emqtt asks for gun "~> 2.1", and gun 2.2+
%% on Hex asks for cowlib ">= 2.15.0 and < 3.0.0", a requirement rebar3
%% cannot parse ("Dep cowlib has invalid version").
{deps, [{emqtt,
         {git, "https://github.com/emqx/emqtt.git", {tag, "1.16.1"}}},
        {gun, "2.1.0"},
        {cowlib, "2.13.0"}]}.

%% --- protobuf: generate src/meshtastic_pb.erl in RECORD mode ---
%% proto/ ships the Meshtastic definitions from
%% https://github.com/meshtastic/protobufs at commit 569a2b3 (GPL-3.0,
%% see proto/LICENSE.meshtastic-protobufs):
%%   proto/nanopb.proto
%%   proto/meshtastic/*.proto
%% proto/meshtastic.proto imports all 28 files.
%% These options must match the ones that produced include/meshtastic/*.hrl.
{plugins, [{rebar3_gpb_plugin, "3.0.1"}]}.

{gpb_opts, [{i, "proto"},
            {f, ["meshtastic.proto"]},
            {module_name_suffix, "_pb"},
            use_packages,
            {rename, {msg_name, snake_case}},
            {rename, {msg_name, dots_to_underscores}},
            {rename, {msg_fqname, base_name}},
            {strings_as_binaries, true},
            type_specs,
            defs_as_maps,
            {o_erl, "src"},
            {o_hrl, "include"}]}.

{provider_hooks, [{pre, [{compile, {protobuf, compile}},
                         {clean, {protobuf, clean}}]}]}.

{shell, [{config, "config/sys.config"},
         {apps, [lora_mesh]}]}.

%% --- self-contained release: `rebar3 as prod tar` ---
%% Bundles the Erlang runtime (ERTS) of the machine it is built on, so
%% the result runs without Erlang installed, on the same OS and CPU
%% (an x86_64 Linux build for PCs, an aarch64 build for a Raspberry Pi).
{relx, [{release, {lora_mesh, "0.3.0"},
         [lora_mesh,
          sasl]},
        {sys_config, "config/sys.config"},
        {vm_args, "config/vm.args"},
        {overlay, [{mkdir, "etc"},
                   {copy, "etc/lora_mesh.config", "etc/lora_mesh.config"},
                   {copy, "etc/lora_mesh.service", "etc/lora_mesh.service"},
                   {copy, "LICENSE", "LICENSE"},
                   {copy, "README.md", "README.md"}]},
        {extended_start_script, true}]}.

{profiles, [{prod, [{relx, [{mode, prod}]}]}]}.
