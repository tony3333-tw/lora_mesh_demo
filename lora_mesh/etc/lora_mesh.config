%% lora_mesh settings. Edit, then restart lora_mesh.
%% Each line is an Erlang term ending in a full stop.

%% full = registry, router, MQTT and bridges; bridge = bridges only
{role, full}.

%% One entry per radio. Meshtastic: the node must have Wi-Fi (API on TCP 4403).
{bridges, [#{id => home, host => "192.168.1.50", port => 4403}]}.
%% Two nodes:
%% {bridges, [#{id => home, host => "192.168.1.50"},
%%            #{id => hill, host => "100.64.0.12"}]}.
%%
%% MeshCore companion radios (type => meshcore):
%%   USB firmware:   transport => serial, device => "/dev/ttyUSB0" (baud 115200)
%%   Wi-Fi firmware: transport => tcp, host => "...", port 5000
%% Meshtastic and MeshCore bridges can be mixed in one list:
%% {bridges, [#{id => home, host => "192.168.1.50"},
%%            #{id => field, type => meshcore, transport => serial,
%%              device => "/dev/serial/by-id/usb-Silicon_Labs_CP2102_...-if00-port0"},
%%            #{id => barn, type => meshcore, transport => tcp,
%%              host => "192.168.1.60"}]}.

%% Window in milliseconds for merging copies heard by several bridges.
{dedup_ms, 200}.

%% MQTT broker. Add username => <<"...">>, password => <<"...">> if needed.
{mqtt, #{host => "localhost", port => 1883, prefix => <<"mesh">>}}.
