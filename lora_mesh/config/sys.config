[
 {lora_mesh,
  [{role, full},                          %% full | bridge (overridden by etc/lora_mesh.config)
   {bridges, [#{id => home,               %% one entry per Meshtastic node
                host => "192.168.1.50",   %% the node's IP (Wi-Fi enabled)
                port => 4403}]},
   %% a second node, e.g. on a hilltop, reached over Tailscale:
   %% {bridges, [#{id => home, host => "192.168.1.50"},
   %%            #{id => hill, host => "100.64.0.12"}]},
   %% MeshCore companion radios, by USB or Wi-Fi:
   %% {bridges, [#{id => field, type => meshcore, transport => serial,
   %%              device => "/dev/ttyUSB0"},
   %%            #{id => barn, type => meshcore, transport => tcp,
   %%              host => "192.168.1.60"}]},
   {dedup_ms, 200},                       %% window for copies from other bridges
   {mqtt, #{host => "localhost",          %% your broker
            port => 1883,
            prefix => <<"mesh">>}}]},

 {kernel,
  [{logger_level, notice}]}
].
