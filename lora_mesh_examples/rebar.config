%% Needs OTP 27+ (the built-in json module).
%%
%% Erlang (src/*.erl) and LFE (src/*.lfe) in one app: the rebar3_lfe
%% plugin adds an LFE compiler to `rebar3 compile'.
%%
%% emqtt, gun and cowlib exactly as in ../lora_mesh/rebar.config (and
%% rebar.config.script turns QUIC off the same way).

{erl_opts, [debug_info]}.

{deps, [{emqtt,
         {git, "https://github.com/emqx/emqtt.git", {tag, "1.16.1"}}},
        {gun, "2.1.0"},
        {cowlib, "2.13.0"},
        {lfe,
         {git, "https://github.com/lfe/lfe.git", {tag, "v2.2.2"}}}]}.

{plugins, [{rebar3_lfe,
            {git, "https://github.com/lfe-rebar3/rebar3_lfe.git", {tag, "0.5.8"}}}]}.

%% `rebar3 escriptize' -> _build/default/bin/lme, one file to copy around.
%% +Bd: Ctrl-C ends the program (no BREAK menu).
{escript_name, lme}.
{escript_main_app, lora_mesh_examples}.
{escript_incl_apps, [lfe, emqtt, gun, cowlib, getopt]}.
{escript_emu_args, "%%! +Bd -escript main lme\n"}.

{shell, [{apps, [lora_mesh_examples]}]}.
